{
  "expo": {
    "name": "Readixo",
    "slug": "readixo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/readixo.png",
    "scheme": "readixo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/86bb2d21-dbfc-411e-bc8b-b78154c07fc3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.linguza.mobile"
    },
    "android": {
      "package": "app.linguza.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#101415",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0f10",
          "image": "./assets/images/splash-icon.png"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#006e2f"
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "86bb2d21-dbfc-411e-bc8b-b78154c07fc3"
      }
    },
    "owner": "alihan.findikci"
  }
}
