{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://english-platform-ytuw.onrender.com",
        "EXPO_PUBLIC_GIZLILIK_URL": "https://english-platform-mu.vercel.app/gizlilik-politikasi",
        "EXPO_PUBLIC_KOSULLAR_URL": "https://english-platform-mu.vercel.app/kullanim-kosullari"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
