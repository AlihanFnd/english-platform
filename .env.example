# ──────────────────────────────────────────────────────────────────
# .env — Ortam değişkenleri
# GÜVENLİK: Bu dosyayı .env olarak kopyalayın ve DEĞERLERİ DOLDURUN.
#           .env dosyası .gitignore içindedir, asla commit edilmez.
#           Buraya gerçek değer YAZILMAZ — bu dosya sürüm kontrolündedir.
# ──────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=appuser
# Üret:  openssl rand -base64 24
POSTGRES_PASSWORD=<DOLDURUN>

# pgAdmin (yalnızca geliştirme)
PGADMIN_EMAIL=<DOLDURUN>
# Üret:  openssl rand -base64 16
PGADMIN_PASSWORD=<DOLDURUN>

# JWT imzalama anahtarı — en az 32 karakter
# Üret:  openssl rand -base64 48
JWT_KEY=<DOLDURUN>

# İlk yönetici hesabı. Boş bırakılırsa hiç yönetici oluşturulmaz.
Seed__AdminEmail=<DOLDURUN>
# Üret:  openssl rand -base64 18
Seed__AdminPassword=<DOLDURUN>

# Groq API anahtarı (isteğe bağlı; yoksa Google Translate'e düşer)
GROQ_API_KEY=

# ─── KURAL-09 + KURAL-14: şifre sıfırlama e-postası (Resend) ────
# https://resend.com → API Keys → Create. Ücretsiz kotası vardır.
# BOŞ BIRAKILIRSA: POST /api/auth/forgot-password ucu 503 döner ve jeton
# ÜRETİLMEZ. Bağlantı hiçbir koşulda loga yazılmaz (eski davranış buydu ve
# log erişimi olan herkesin hesap ele geçirmesine izin veriyordu).
Resend__ApiKey=
# Gönderen adres. Kendi alan adını doğrulayana kadar Resend'in test adresi kullanılabilir.
Resend__Gonderen=Linguza <onboarding@resend.dev>
# Sıfırlama bağlantısındaki taban adres (kullanıcının tarayıcıda açacağı site).
# KURAL-14: BOŞ BIRAKILIRSA uç yine 503 döner — sessizce localhost'a düşen,
# kullanıcı için işe yaramaz bir bağlantı ÜRETİLMEZ. Üretimde gerçek adres yazın.
App__FrontendUrl=http://localhost:3000

# ─── KURAL-13: köken ve kaynak denetimi ─────────────────────────
# Tarayıcıdan API'ye erişebilecek kökenler (virgülle ayrılmış, tam köken).
# ÜRETİMDE ZORUNLU — tanımsızsa uygulama BAŞLAMAZ (fail-fast).
# Üretimde http:// köken kabul edilmez; joker (*) hiçbir ortamda kabul edilmez.
# Geliştirmede boş bırakılırsa localhost:3000 ve localhost:3001'e düşer.
CorsOrigins=http://localhost:3000,http://localhost:3001
# API'nin kendi alan adı — Host başlığı doğrulaması için (yalnızca üretimde uygulanır).
# Üretim örneği: linguza-api.onrender.com
PublicHost=localhost
